---
import { url } from "@/utils/url-utils";

interface Props {
  image?: string;
  alt?: string;
  name?: string;
  messages?: string[];
  side?: "left" | "right";
  bottom?: number;
  width?: number;
  hideOnMobile?: boolean;
}

const {
  image = "/assets/companion/istra-companion.webp",
  alt = "Interactive blog companion",
  name = "COMPANION",
  messages = [
    "……真是的，不可以哦？",
    "喂，别一直这样盯着我看啦……真是的。",
    "制作人，今天会一直陪着我吧？",
    "要是我半夜说“现在就来见我”，制作人真的会来吗？",
    "……现在就来见我。开玩笑的——还是说，你会当真？",
    "嗯？一见钟情……是第一次吗？",
    "要去冈山打招呼？啊哈哈，听起来像家访一样……还是说，是更特别的那种？",
    "车站附近的灯饰很好看哦。……嘿嘿，其实我是在邀请你啦。",
    "制作人，可以让我靠近一点取暖吗？因为真的很冷嘛。",
    "你今天是不是有点忙？那我就……稍微等你一下好了。",
    "这么晚还不休息？陪我说一会儿话也行，但不许太勉强自己。",
    "你每次点我一下，我都要回应吗？……那可得负责哦。",
  ],
  side = "right",
  bottom = 12,
  width = 300,
  hideOnMobile = true,
} = Astro.props;

const imageUrl = url(image);

const sparkles = [
  { x: 10, y: 15, s: 5, d: -0.5, t: 3.6 },
  { x: 83, y: 11, s: 7, d: -1.8, t: 4.4 },
  { x: 92, y: 34, s: 4, d: -2.3, t: 3.1 },
  { x: 4, y: 46, s: 6, d: -1.2, t: 4.9 },
  { x: 88, y: 63, s: 5, d: -3.1, t: 3.9 },
  { x: 18, y: 72, s: 4, d: -0.9, t: 4.1 },
  { x: 72, y: 82, s: 7, d: -2.6, t: 5.2 },
  { x: 42, y: 5, s: 4, d: -1.4, t: 3.4 },
  { x: 58, y: 25, s: 3, d: -2.1, t: 3.8 },
  { x: 31, y: 88, s: 5, d: -3.4, t: 4.7 },
];
---

<div
  id="shimmer-companion"
  class:list={["shimmer-companion", `side-${side}`]}
  style={`--companion-width:${width}px;--companion-bottom:${bottom}px;`}
  data-messages={JSON.stringify(messages)}
  data-hide-mobile={hideOnMobile ? "true" : "false"}
>
  <div class="sc-ambient" aria-hidden="true">
    {
      sparkles.map((spark) => (
        <i
          class="sc-spark"
          style={`--x:${spark.x}%;--y:${spark.y}%;--s:${spark.s}px;--delay:${spark.d}s;--time:${spark.t}s;`}
        />
      ))
    }
  </div>

  <div class="sc-dialog" role="status" aria-live="polite" aria-atomic="true">
    <div class="sc-dialog-frame">
      <div class="sc-dialog-header">
        <span class="sc-signal">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span class="sc-name">{name}</span>
        <span class="sc-code">✦ 07</span>
      </div>

      <p class="sc-dialog-text"></p>

      <div class="sc-dialog-footer" aria-hidden="true">
        <span>LINK / ACTIVE</span>
        <span class="sc-mini-line"></span>
        <span>◇</span>
      </div>

      <span class="sc-corner sc-corner-a"></span>
      <span class="sc-corner sc-corner-b"></span>
      <span class="sc-scanline" aria-hidden="true"></span>
    </div>
    <span class="sc-dialog-tail" aria-hidden="true"></span>
  </div>

  <button
    class="sc-character-trigger"
    type="button"
    aria-label={`和 ${name} 对话`}
    title="点击对话"
  >
    <span class="sc-aura sc-aura-a" aria-hidden="true"></span>
    <span class="sc-aura sc-aura-b" aria-hidden="true"></span>
    <span class="sc-ring" aria-hidden="true"></span>

    <img
      class="sc-character"
      src={imageUrl}
      alt={alt}
      draggable="false"
      decoding="async"
    />

    <span class="sc-shimmer" aria-hidden="true"></span>

    <span class="sc-tap-hint" aria-hidden="true">
      <b>✦</b>
      <span>TOUCH</span>
      <b>✦</b>
    </span>
  </button>
</div>

<script>
  function initShimmerCompanion() {
    const root = document.getElementById("shimmer-companion");
    if (!root || root.dataset.ready === "1") return;

    root.dataset.ready = "1";

    const trigger = root.querySelector(".sc-character-trigger");
    const dialog = root.querySelector(".sc-dialog");
    const text = root.querySelector(".sc-dialog-text");

    if (!trigger || !dialog || !text) return;

    let messages = [];
    try {
      messages = JSON.parse(root.dataset.messages || "[]");
    } catch {
      messages = [];
    }

    let lastIndex = -1;
    let hideTimer = 0;
    let typeTimer = 0;

    const chooseMessage = () => {
      if (!messages.length) return "你好。";

      if (messages.length === 1) {
        lastIndex = 0;
        return messages[0];
      }

      let next = lastIndex;
      while (next === lastIndex) {
        next = Math.floor(Math.random() * messages.length);
      }

      lastIndex = next;
      return messages[next];
    };

    const typeMessage = (message) => {
      window.clearInterval(typeTimer);

      const chars = Array.from(message);
      text.textContent = "";
      let index = 0;

      typeTimer = window.setInterval(() => {
        text.textContent += chars[index] || "";
        index += 1;

        if (index >= chars.length) {
          window.clearInterval(typeTimer);
        }
      }, 22);
    };

    const showDialog = () => {
      window.clearTimeout(hideTimer);

      typeMessage(chooseMessage());
      dialog.classList.add("is-open");

      hideTimer = window.setTimeout(() => {
        dialog.classList.remove("is-open");
      }, 5200);
    };

    const createBurst = (event) => {
      const rect = root.getBoundingClientRect();
      const originX =
        typeof event.clientX === "number"
          ? event.clientX - rect.left
          : rect.width * 0.5;
      const originY =
        typeof event.clientY === "number"
          ? event.clientY - rect.top
          : rect.height * 0.45;

      for (let i = 0; i < 10; i += 1) {
        const particle = document.createElement("span");
        particle.className = "sc-burst";

        const angle = (Math.PI * 2 * i) / 10 + Math.random() * 0.35;
        const distance = 34 + Math.random() * 54;

        particle.style.left = `${originX}px`;
        particle.style.top = `${originY}px`;
        particle.style.setProperty(
          "--dx",
          `${Math.cos(angle) * distance}px`,
        );
        particle.style.setProperty(
          "--dy",
          `${Math.sin(angle) * distance}px`,
        );
        particle.style.setProperty(
          "--burst-size",
          `${3 + Math.random() * 5}px`,
        );
        particle.style.setProperty(
          "--burst-delay",
          `${Math.random() * 0.08}s`,
        );

        root.appendChild(particle);
        window.setTimeout(() => particle.remove(), 900);
      }
    };

    trigger.addEventListener("click", (event) => {
      root.classList.remove("is-reacting");
      void root.offsetWidth;
      root.classList.add("is-reacting");

      createBurst(event);
      showDialog();

      window.setTimeout(() => {
        root.classList.remove("is-reacting");
      }, 560);
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initShimmerCompanion, {
      once: true,
    });
  } else {
    initShimmerCompanion();
  }
</script>

<style is:global>
  .shimmer-companion {
    --sc-cyan: 174 226 255;
    --sc-blue: 151 185 255;
    --sc-lilac: 198 174 255;
    --sc-pink: 255 187 224;
    --sc-ink: 20 23 42;

    position: fixed;
    z-index: 72;
    bottom: var(--companion-bottom);
    width: var(--companion-width);
    aspect-ratio: 5 / 6;
    pointer-events: none;
    isolation: isolate;
  }

  .shimmer-companion.side-right {
    right: 12px;
  }

  .shimmer-companion.side-left {
    left: 12px;
  }

  .sc-character-trigger {
    position: absolute;
    inset: 0 0 0 auto;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    background: transparent;
    cursor: pointer;
    pointer-events: auto;
    transform-origin: 50% 82%;
    animation: sc-character-float 5.2s ease-in-out infinite;
  }

  .sc-character-trigger:focus-visible {
    outline: 2px solid rgb(var(--sc-cyan) / 0.85);
    outline-offset: 5px;
    border-radius: 24px;
  }

  .sc-character {
    position: absolute;
    z-index: 4;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center bottom;
    user-select: none;
    filter:
      drop-shadow(0 18px 24px rgb(15 20 45 / 0.22))
      drop-shadow(0 0 14px rgb(var(--sc-blue) / 0.18));
    transition:
      filter 0.35s ease,
      transform 0.35s ease;
  }

  .sc-character-trigger:hover .sc-character {
    filter:
      drop-shadow(0 20px 28px rgb(15 20 45 / 0.28))
      drop-shadow(0 0 20px rgb(var(--sc-cyan) / 0.34))
      drop-shadow(0 0 32px rgb(var(--sc-pink) / 0.17));
  }

  .shimmer-companion.is-reacting .sc-character {
    animation: sc-character-react 0.56s cubic-bezier(0.22, 0.86, 0.35, 1);
  }

  .sc-aura,
  .sc-ring {
    position: absolute;
    z-index: 1;
    pointer-events: none;
  }

  .sc-aura {
    border-radius: 999px;
    filter: blur(14px);
    opacity: 0.5;
    mix-blend-mode: screen;
  }

  .sc-aura-a {
    width: 68%;
    aspect-ratio: 1;
    right: 2%;
    bottom: 17%;
    background:
      radial-gradient(circle, rgb(var(--sc-cyan) / 0.38), transparent 66%);
    animation: sc-aura-pulse 4.2s ease-in-out infinite;
  }

  .sc-aura-b {
    width: 52%;
    aspect-ratio: 1;
    left: 4%;
    top: 10%;
    background:
      radial-gradient(circle, rgb(var(--sc-pink) / 0.28), transparent 68%);
    animation: sc-aura-pulse 5.3s ease-in-out -1.7s infinite reverse;
  }

  .sc-ring {
    width: 68%;
    aspect-ratio: 1;
    right: 3%;
    bottom: 14%;
    border: 1px solid rgb(var(--sc-cyan) / 0.18);
    border-radius: 50%;
    box-shadow:
      inset 0 0 20px rgb(var(--sc-lilac) / 0.1),
      0 0 24px rgb(var(--sc-cyan) / 0.08);
    animation: sc-ring-spin 13s linear infinite;
  }

  .sc-ring::before,
  .sc-ring::after {
    content: "";
    position: absolute;
    inset: 8%;
    border: 1px dashed rgb(var(--sc-pink) / 0.16);
    border-radius: 50%;
  }

  .sc-ring::after {
    inset: 23%;
    border-style: solid;
    border-color:
      rgb(var(--sc-blue) / 0.18)
      transparent
      rgb(var(--sc-pink) / 0.18)
      transparent;
  }

  .sc-shimmer {
    position: absolute;
    z-index: 5;
    top: 6%;
    bottom: 8%;
    left: 12%;
    width: 18%;
    pointer-events: none;
    opacity: 0;
    background: linear-gradient(
      90deg,
      transparent,
      rgb(255 255 255 / 0.64),
      rgb(var(--sc-cyan) / 0.38),
      transparent
    );
    filter: blur(7px);
    transform: skewX(-18deg) translateX(-260%);
    mix-blend-mode: screen;
    animation: sc-shimmer-sweep 7.2s ease-in-out 1.6s infinite;
  }

  .sc-tap-hint {
    position: absolute;
    z-index: 7;
    right: 5%;
    bottom: 3%;
    display: flex;
    gap: 7px;
    align-items: center;
    padding: 5px 10px;
    border: 1px solid rgb(255 255 255 / 0.46);
    border-radius: 999px;
    color: rgb(255 255 255 / 0.93);
    background:
      linear-gradient(120deg, rgb(23 26 52 / 0.58), rgb(64 46 90 / 0.43));
    box-shadow:
      0 8px 24px rgb(20 24 48 / 0.16),
      inset 0 0 12px rgb(var(--sc-cyan) / 0.08);
    backdrop-filter: blur(10px);
    font-size: 9px;
    line-height: 1;
    letter-spacing: 0.18em;
    opacity: 0.44;
    transform: translateY(3px);
    transition:
      opacity 0.25s ease,
      transform 0.25s ease;
  }

  .sc-tap-hint b {
    color: rgb(var(--sc-cyan));
    font-size: 8px;
  }

  .sc-character-trigger:hover .sc-tap-hint {
    opacity: 0.9;
    transform: translateY(0);
  }

  .sc-ambient {
    position: absolute;
    z-index: 6;
    inset: -8%;
    pointer-events: none;
  }

  .sc-spark {
    position: absolute;
    left: var(--x);
    top: var(--y);
    width: var(--s);
    height: var(--s);
    opacity: 0.08;
    transform: rotate(45deg) scale(0.4);
    background: rgb(255 255 255 / 0.96);
    box-shadow:
      0 0 8px rgb(var(--sc-cyan) / 0.76),
      0 0 18px rgb(var(--sc-lilac) / 0.36);
    animation: sc-sparkle var(--time) ease-in-out var(--delay) infinite;
  }

  .sc-spark:nth-child(3n) {
    background: rgb(var(--sc-pink) / 0.96);
  }

  .sc-spark:nth-child(3n + 1) {
    background: rgb(var(--sc-cyan) / 0.96);
  }

  .sc-dialog {
    position: absolute;
    z-index: 12;
    bottom: 55%;
    width: min(318px, 42vw);
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.26s ease,
      transform 0.42s cubic-bezier(0.18, 0.9, 0.24, 1.22);
  }

  .side-right .sc-dialog {
    right: calc(100% - 16px);
    transform: translate(16px, 14px) scale(0.88);
    transform-origin: 100% 100%;
  }

  .side-left .sc-dialog {
    left: calc(100% - 16px);
    transform: translate(-16px, 14px) scale(0.88);
    transform-origin: 0 100%;
  }

  .sc-dialog.is-open {
    opacity: 1;
  }

  .side-right .sc-dialog.is-open,
  .side-left .sc-dialog.is-open {
    transform: translate(0, 0) scale(1);
  }

  .sc-dialog-frame {
    position: relative;
    overflow: hidden;
    padding: 14px 15px 12px;
    border: 1px solid rgb(var(--sc-cyan) / 0.42);
    border-radius: 16px 5px 16px 5px;
    color: rgb(248 249 255 / 0.97);
    background:
      linear-gradient(135deg, rgb(26 28 53 / 0.78), rgb(62 48 86 / 0.58)),
      radial-gradient(circle at 18% 0%, rgb(var(--sc-cyan) / 0.13), transparent 42%);
    box-shadow:
      0 16px 42px rgb(15 18 40 / 0.24),
      0 0 0 1px rgb(var(--sc-pink) / 0.12),
      inset 0 0 28px rgb(var(--sc-blue) / 0.08);
    backdrop-filter: blur(15px) saturate(1.25);
  }

  .sc-dialog-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(105deg, transparent 5%, rgb(255 255 255 / 0.08) 35%, transparent 62%),
      repeating-linear-gradient(
        0deg,
        rgb(255 255 255 / 0.018) 0,
        rgb(255 255 255 / 0.018) 1px,
        transparent 1px,
        transparent 4px
      );
  }

  .sc-dialog-header,
  .sc-dialog-footer {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
  }

  .sc-dialog-header {
    gap: 8px;
    padding-bottom: 8px;
    border-bottom: 1px solid rgb(var(--sc-cyan) / 0.16);
  }

  .sc-signal {
    display: flex;
    gap: 3px;
  }

  .sc-signal i {
    width: 4px;
    height: 4px;
    border-radius: 999px;
    background: rgb(var(--sc-cyan) / 0.85);
    box-shadow: 0 0 8px rgb(var(--sc-cyan) / 0.65);
  }

  .sc-signal i:nth-child(2) {
    opacity: 0.62;
  }

  .sc-signal i:nth-child(3) {
    opacity: 0.3;
  }

  .sc-name {
    flex: 1;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
  }

  .sc-code {
    color: rgb(var(--sc-pink) / 0.82);
    font-size: 9px;
    letter-spacing: 0.08em;
  }

  .sc-dialog-text {
    position: relative;
    z-index: 2;
    min-height: 46px;
    margin: 12px 2px 10px;
    font-size: 14px;
    line-height: 1.72;
    letter-spacing: 0.035em;
    text-shadow: 0 2px 9px rgb(7 11 27 / 0.32);
  }

  .sc-dialog-footer {
    gap: 7px;
    color: rgb(var(--sc-cyan) / 0.52);
    font-size: 8px;
    letter-spacing: 0.13em;
  }

  .sc-mini-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(
      90deg,
      rgb(var(--sc-cyan) / 0.08),
      rgb(var(--sc-cyan) / 0.42),
      rgb(var(--sc-pink) / 0.14)
    );
  }

  .sc-corner {
    position: absolute;
    z-index: 3;
    width: 13px;
    height: 13px;
    pointer-events: none;
  }

  .sc-corner-a {
    top: 5px;
    left: 5px;
    border-top: 1px solid rgb(var(--sc-cyan) / 0.72);
    border-left: 1px solid rgb(var(--sc-cyan) / 0.72);
  }

  .sc-corner-b {
    right: 5px;
    bottom: 5px;
    border-right: 1px solid rgb(var(--sc-pink) / 0.66);
    border-bottom: 1px solid rgb(var(--sc-pink) / 0.66);
  }

  .sc-scanline {
    position: absolute;
    z-index: 1;
    top: -12%;
    left: -15%;
    width: 130%;
    height: 16%;
    pointer-events: none;
    opacity: 0.22;
    background: linear-gradient(
      180deg,
      transparent,
      rgb(var(--sc-cyan) / 0.25),
      transparent
    );
    filter: blur(4px);
    animation: sc-dialog-scan 4.8s ease-in-out infinite;
  }

  .sc-dialog-tail {
    position: absolute;
    top: 58%;
    width: 14px;
    height: 14px;
    border-right: 1px solid rgb(var(--sc-cyan) / 0.34);
    border-bottom: 1px solid rgb(var(--sc-cyan) / 0.34);
    background: rgb(42 36 70 / 0.72);
    backdrop-filter: blur(12px);
  }

  .side-right .sc-dialog-tail {
    right: -7px;
    transform: rotate(-45deg);
  }

  .side-left .sc-dialog-tail {
    left: -7px;
    transform: rotate(135deg);
  }

  .sc-burst {
    position: absolute;
    z-index: 20;
    width: var(--burst-size);
    height: var(--burst-size);
    border-radius: 1px;
    pointer-events: none;
    background: rgb(255 255 255 / 0.95);
    box-shadow:
      0 0 9px rgb(var(--sc-cyan) / 0.8),
      0 0 18px rgb(var(--sc-pink) / 0.4);
    transform: translate(-50%, -50%) rotate(45deg);
    animation: sc-burst-out 0.82s ease-out var(--burst-delay) forwards;
  }

  @keyframes sc-character-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }
    50% {
      transform: translate3d(0, -7px, 0) rotate(0.35deg);
    }
  }

  @keyframes sc-character-react {
    0% {
      transform: translateY(0) scale(1);
    }
    36% {
      transform: translateY(-9px) scale(1.025) rotate(-0.8deg);
    }
    68% {
      transform: translateY(2px) scale(0.995) rotate(0.35deg);
    }
    100% {
      transform: translateY(0) scale(1);
    }
  }

  @keyframes sc-aura-pulse {
    0%,
    100% {
      opacity: 0.22;
      transform: scale(0.92);
    }
    50% {
      opacity: 0.62;
      transform: scale(1.08);
    }
  }

  @keyframes sc-ring-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @keyframes sc-shimmer-sweep {
    0%,
    76% {
      opacity: 0;
      transform: skewX(-18deg) translateX(-280%);
    }
    82% {
      opacity: 0.54;
    }
    96% {
      opacity: 0;
      transform: skewX(-18deg) translateX(560%);
    }
    100% {
      opacity: 0;
    }
  }

  @keyframes sc-sparkle {
    0%,
    100% {
      opacity: 0.05;
      transform: rotate(45deg) scale(0.38);
    }
    50% {
      opacity: 0.92;
      transform: rotate(45deg) scale(1);
    }
  }

  @keyframes sc-dialog-scan {
    0% {
      transform: translateY(-80%);
    }
    100% {
      transform: translateY(760%);
    }
  }

  @keyframes sc-burst-out {
    0% {
      opacity: 1;
      transform: translate(-50%, -50%) rotate(45deg) scale(1);
    }
    100% {
      opacity: 0;
      transform:
        translate(
          calc(-50% + var(--dx)),
          calc(-50% + var(--dy))
        )
        rotate(165deg)
        scale(0.2);
    }
  }

  @media (max-width: 768px) {
    .shimmer-companion[data-hide-mobile="true"] {
      display: none;
    }

    .shimmer-companion[data-hide-mobile="false"] {
      --companion-width: 205px !important;
      right: 0;
      left: auto;
      bottom: 4px;
    }

    .shimmer-companion[data-hide-mobile="false"] .sc-dialog {
      right: 14px;
      bottom: 76%;
      width: min(270px, calc(100vw - 30px));
      transform-origin: 100% 100%;
    }

    .shimmer-companion[data-hide-mobile="false"] .sc-dialog-tail {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sc-character-trigger,
    .sc-aura,
    .sc-ring,
    .sc-shimmer,
    .sc-spark,
    .sc-scanline {
      animation: none !important;
    }

    .sc-dialog {
      transition: opacity 0.18s ease;
    }
  }
</style>
